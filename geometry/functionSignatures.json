{
"_schemaVersion": "1.0.0",

"_comment": "MTEX code suggestions for the geometric core classes - vectors, Miller indices, rotations, orientations, symmetries and fibres.",

"_comment2": "crystalSymmetry has two signatures: the group given by its symbol (always the first argument, never an alignment flag) or by a numerical id. The alignment of the Cartesian to the crystal coordinate system is given by one flag per Cartesian axis, e.g. crystalSymmetry('2/m',...,'X||a','Z||c*').",

"crystalSymmetry":
{
    "inputs":
    [
      {"name":"pointGroup", "kind":"required", "type":["char","choices=unique([{symmetry.pointGroups.Inter},{symmetry.pointGroups.Schoen},[symmetry.pointGroups.altNames],cellfun(@char,{symmetry.pointGroups.lattice},'UniformOutput',false)])"], "purpose":"point group (International or Schoenflies) or space group symbol"},
      {"name":"axes", "kind":"ordered", "type":["numeric","vector","numel=3"], "purpose":"[a b c] length of the crystallographic axes"},
      {"name":"angles", "kind":"ordered", "type":["numeric","vector","numel=3"], "purpose":"[alpha beta gamma] between the axes"},
      {"name":"mineral", "kind":"namevalue", "type":["char"], "purpose":"mineral name"},
      {"name":"color", "kind":"namevalue", "type":["choices=str2rgb"], "purpose":"color used in EBSD phase plots"},
      {"name":"density", "kind":"namevalue", "type":["numeric","scalar",">0"]},
      {"name":"rotAxes", "kind":"namevalue", "type":["rotation"]},
      {"name":"alignX", "kind":"flag", "type":["char","choices={'X||a','X||a*','X||b','X||b*','X||c','X||c*','X||m'}"], "purpose":"alignment of the Cartesian X axis"},
      {"name":"alignY", "kind":"flag", "type":["char","choices={'Y||a','Y||a*','Y||b','Y||b*','Y||c','Y||c*','Y||m'}"], "purpose":"alignment of the Cartesian Y axis"},
      {"name":"alignZ", "kind":"flag", "type":["char","choices={'Z||a','Z||a*','Z||b','Z||b*','Z||c','Z||c*','Z||m'}"], "purpose":"alignment of the Cartesian Z axis"},
      {"name":"vendor", "kind":"flag", "type":["char","choices={'EDAX','TSL','OIM'}"], "purpose":"use the alignment convention of this vendor"}
    ],
    "outputs":
    [
      {"name":"cs", "type":"crystalSymmetry"}
    ]
},

"crystalSymmetry":
{
    "inputs":
    [
      {"name":"LaueId", "kind":"namevalue", "type":["numeric","scalar","integer",">0","<=11"]},
      {"name":"SpaceId", "kind":"namevalue", "type":["numeric","scalar","integer",">0","<=230"]},
      {"name":"pointId", "kind":"namevalue", "type":["numeric","scalar","integer",">0"]},
      {"name":"mineral", "kind":"namevalue", "type":["char"], "purpose":"mineral name"},
      {"name":"color", "kind":"namevalue", "type":["choices=str2rgb"], "purpose":"color used in EBSD phase plots"},
      {"name":"density", "kind":"namevalue", "type":["numeric","scalar",">0"]},
      {"name":"rotAxes", "kind":"namevalue", "type":["rotation"]}
    ],
    "outputs":
    [
      {"name":"cs", "type":"crystalSymmetry"}
    ]
},

"crystalSymmetry.load":
{
    "inputs":
    [
      {"name":"fname", "kind":"required", "type":["char","choices=arrayfun(@(x) getfield(x,'name'),dir([mtexCifPath filesep '*.cif']),'uniformOutput',false)"], "purpose":"cif file"},
      {"name":"mineral", "kind":"namevalue", "type":["char"]},
      {"name":"color", "kind":"namevalue", "type":["choices=str2rgb"]}
    ]
},

"specimenSymmetry":
{
    "inputs":
    [
      {"name":"pointGroup", "kind":"ordered", "type":["char","choices={'1','-1','triclinic','2','2/m','monoclinic','222','mmm','orthorhombic','4/mmm','6/mmm'}"], "purpose":"usually triclinic or orthorhombic"}
    ],
    "outputs":
    [
      {"name":"ss", "type":"specimenSymmetry"}
    ]
},

"referenceFrame":
{
    "inputs":
    [
      {"name":"basis", "kind":"ordered", "type":["vector3d"], "purpose":"the three basis vectors"},
      {"name":"name", "kind":"namevalue", "type":["char"], "purpose":"identity of the frame"}
    ],
    "outputs":
    [
      {"name":"rf", "type":"referenceFrame"}
    ]
},

"crystalFrame":
{
    "inputs":
    [
      {"name":"axes", "kind":"ordered", "type":["vector3d"], "purpose":"the crystal axes a, b, c"},
      {"name":"name", "kind":"namevalue", "type":["char"], "purpose":"identity of the frame"}
    ],
    "outputs":
    [
      {"name":"cF", "type":"crystalFrame"}
    ]
},

"specimenFrame":
{
    "inputs":
    [
      {"name":"name", "kind":"ordered", "type":["char"], "purpose":"identity of the frame"},
      {"name":"axesNames", "kind":"namevalue", "type":["cell"], "purpose":"names of the three axes"},
      {"name":"how2plot", "kind":"ordered", "type":["plottingConvention"], "purpose":"default plotting convention"}
    ],
    "outputs":
    [
      {"name":"sF", "type":"specimenFrame"}
    ]
},

"gridLayout":
{
    "inputs":
    [
      {"name":"rowDir", "kind":"ordered", "type":["vector3d"], "purpose":"direction the row index advances along"},
      {"name":"colDir", "kind":"ordered", "type":["vector3d"], "purpose":"direction the column index advances along"},
      {"name":"name", "kind":"namevalue", "type":["char"], "purpose":"identity of the layout"}
    ],
    "outputs":
    [
      {"name":"gL", "type":"gridLayout"}
    ]
},

"layoutIndex":
{
    "inputs":
    [
      {"name":"gL", "kind":"required", "type":["gridLayout"], "purpose":"layout the array is to be laid out in"},
      {"name":"dims", "kind":"required", "type":["vector3d"], "purpose":"directions dimensions 1 and 2 advance along"},
      {"name":"sz", "kind":"required", "type":["numeric","vector"], "purpose":"size of the array"},
      {"name":"nearest", "kind":"flag", "type":["char","choices={'nearest'}"], "purpose":"snap to the closest layout instead of erroring"}
    ],
    "outputs":
    [
      {"name":"lin", "type":"numeric"},
      {"name":"doTranspose", "type":"logical"}
    ]
},

"vector3d":
{
    "inputs":
    [
      {"name":"x", "kind":"ordered", "type":["numeric"]},
      {"name":"y", "kind":"ordered", "type":["numeric"]},
      {"name":"z", "kind":"ordered", "type":["numeric"]},
      {"name":"antipodal", "kind":"flag", "type":["char","choices={'antipodal'}"]}
    ],
    "outputs":
    [
      {"name":"v", "type":"vector3d"}
    ]
},

"vector3d.byPolar":
{
    "inputs":
    [
      {"name":"theta", "kind":"required", "type":["numeric"], "purpose":"polar angle"},
      {"name":"rho", "kind":"required", "type":["numeric"], "purpose":"azimuth angle"},
      {"name":"r", "kind":"ordered", "type":["numeric"], "purpose":"radius"},
      {"name":"antipodal", "kind":"flag", "type":["char","choices={'antipodal'}"]}
    ]
},

"vector3d.load":
{
    "inputs":
    [
      {"name":"fname", "kind":"required", "type":["file=*.txt,*.csv,*.dat"]},
      {"name":"columnNames", "kind":"namevalue", "type":["cell"], "purpose":"e.g. {'x','y','z'} or {'polar angle','azimuth'}"},
      {"name":"columns", "kind":"namevalue", "type":["numeric","vector"]},
      {"name":"delimiter", "kind":"namevalue", "type":["char"]},
      {"name":"header", "kind":"namevalue", "type":["numeric","scalar",">=0"]},
      {"name":"radians", "kind":"flag"}
    ]
},

"Miller":
{
    "inputs":
    [
      {"name":"h", "kind":"required", "type":[["numeric"],["char"],["cell"],["vector3d"]], "purpose":"index, '(hkl)' string or vector3d"},
      {"name":"k", "kind":"ordered", "type":[["numeric"],["cell"]]},
      {"name":"l", "kind":"ordered", "type":[["numeric"],["cell"]]},
      {"name":"w", "kind":"ordered", "type":[["numeric"],["cell"]], "purpose":"fourth index for hkil / UVTW"},
      {"name":"cs", "kind":"ordered", "type":["crystalSymmetry"]},
      {"name":"dispStyle", "kind":"flag", "type":["char","choices={'hkl','uvw','hkil','UVTW'}"]},
      {"name":"antipodal", "kind":"flag", "type":["char","choices={'antipodal'}"]}
    ],
    "outputs":
    [
      {"name":"m", "type":"Miller"}
    ]
},

"orientation":
{
    "inputs":
    [
      {"name":"rot", "kind":"required", "type":[["rotation"],["quaternion"],["numeric"]]},
      {"name":"cs", "kind":"ordered", "type":["crystalSymmetry"]},
      {"name":"ss", "kind":"ordered", "type":[["specimenSymmetry"],["crystalSymmetry"]]},
      {"name":"antipodal", "kind":"flag", "type":["char","choices={'antipodal'}"]}
    ],
    "outputs":
    [
      {"name":"ori", "type":"orientation"}
    ]
},

"orientation.byEuler":
{
    "inputs":
    [
      {"name":"phi1", "kind":"required", "type":["numeric"]},
      {"name":"Phi", "kind":"required", "type":["numeric"]},
      {"name":"phi2", "kind":"required", "type":["numeric"]},
      {"name":"cs", "kind":"ordered", "type":["crystalSymmetry"]},
      {"name":"ss", "kind":"ordered", "type":[["specimenSymmetry"],["crystalSymmetry"]]},
      {"name":"convention", "kind":"flag", "type":["char","choices={'ZYZ','ZXZ','Bunge','ABG','nfft'}"]}
    ]
},

"orientation.byAxisAngle":
{
    "inputs":
    [
      {"name":"v", "kind":"required", "type":["vector3d"], "purpose":"rotational axis"},
      {"name":"omega", "kind":"required", "type":["numeric"], "purpose":"rotational angle"},
      {"name":"cs", "kind":"ordered", "type":["crystalSymmetry"]},
      {"name":"ss", "kind":"ordered", "type":[["specimenSymmetry"],["crystalSymmetry"]]}
    ]
},

"orientation.byMatrix":
{
    "inputs":
    [
      {"name":"A", "kind":"required", "type":["numeric"], "purpose":"3x3xN rotation matrices"},
      {"name":"cs", "kind":"ordered", "type":["crystalSymmetry"]},
      {"name":"ss", "kind":"ordered", "type":[["specimenSymmetry"],["crystalSymmetry"]]}
    ]
},

"orientation.byMiller":
{
    "inputs":
    [
      {"name":"hkl", "kind":"required", "type":["numeric","vector"]},
      {"name":"uvw", "kind":"required", "type":["numeric","vector"]},
      {"name":"cs", "kind":"ordered", "type":["crystalSymmetry"]},
      {"name":"ss", "kind":"ordered", "type":[["specimenSymmetry"],["crystalSymmetry"]]}
    ]
},

"orientation.byRodrigues":
{
    "inputs":
    [
      {"name":"v", "kind":"required", "type":[["vector3d"],["numeric"]]},
      {"name":"cs", "kind":"ordered", "type":["crystalSymmetry"]},
      {"name":"ss", "kind":"ordered", "type":[["specimenSymmetry"],["crystalSymmetry"]]}
    ]
},

"orientation.map":
{
    "inputs":
    [
      {"name":"u1", "kind":"required", "type":["vector3d"]},
      {"name":"v1", "kind":"required", "type":["vector3d"]},
      {"name":"u2", "kind":"ordered", "type":["vector3d"]},
      {"name":"v2", "kind":"ordered", "type":["vector3d"]},
      {"name":"cs", "kind":"ordered", "type":["crystalSymmetry"]},
      {"name":"ss", "kind":"ordered", "type":[["specimenSymmetry"],["crystalSymmetry"]]}
    ]
},

"orientation.rand":
{
    "inputs":
    [
      {"name":"n", "kind":"ordered", "type":["numeric","scalar","integer",">0"]},
      {"name":"cs", "kind":"ordered", "type":["crystalSymmetry"]},
      {"name":"ss", "kind":"ordered", "type":[["specimenSymmetry"],["crystalSymmetry"]]}
    ]
},

"orientation.load":
{
    "inputs":
    [
      {"name":"fname", "kind":"required", "type":["file=*.txt,*.csv,*.dat"]},
      {"name":"cs", "kind":"ordered", "type":["crystalSymmetry"]},
      {"name":"ss", "kind":"ordered", "type":["specimenSymmetry"]},
      {"name":"columnNames", "kind":"namevalue", "type":["cell"], "purpose":"mandatory are Euler 1, Euler 2, Euler 3"},
      {"name":"columns", "kind":"namevalue", "type":["numeric","vector"]},
      {"name":"delimiter", "kind":"namevalue", "type":["char"]},
      {"name":"header", "kind":"namevalue", "type":["numeric","scalar",">=0"]},
      {"name":"convention", "kind":"flag", "type":["char","choices={'Bunge','ABG','radians','passive'}"]}
    ]
},

"rotation":
{
    "inputs":
    [
      {"name":"q", "kind":"required", "type":[["quaternion"],["numeric"]]},
      {"name":"antipodal", "kind":"flag", "type":["char","choices={'antipodal'}"]}
    ],
    "outputs":
    [
      {"name":"rot", "type":"rotation"}
    ]
},

"rotation.byEuler":
{
    "inputs":
    [
      {"name":"phi1", "kind":"required", "type":["numeric"]},
      {"name":"Phi", "kind":"required", "type":["numeric"]},
      {"name":"phi2", "kind":"required", "type":["numeric"]},
      {"name":"convention", "kind":"flag", "type":["char","choices={'ZYZ','ZXZ','Bunge','ABG','nfft'}"]}
    ]
},

"rotation.byAxisAngle":
{
    "inputs":
    [
      {"name":"v", "kind":"required", "type":["vector3d"], "purpose":"rotational axis"},
      {"name":"omega", "kind":"required", "type":["numeric"], "purpose":"rotational angle"}
    ]
},

"rotation.byMatrix":
{
    "inputs":
    [
      {"name":"A", "kind":"required", "type":["numeric"], "purpose":"3x3xN rotation matrices"}
    ]
},

"rotation.map":
{
    "inputs":
    [
      {"name":"u1", "kind":"required", "type":["vector3d"]},
      {"name":"v1", "kind":"required", "type":["vector3d"]},
      {"name":"u2", "kind":"ordered", "type":["vector3d"]},
      {"name":"v2", "kind":"ordered", "type":["vector3d"]}
    ]
},

"fibre":
{
    "inputs":
    [
      {"name":"o1", "kind":"required", "type":[["orientation"],["Miller"],["vector3d"]], "purpose":"start orientation or crystal direction h"},
      {"name":"o2", "kind":"required", "type":[["orientation"],["vector3d"]], "purpose":"end orientation or specimen direction r"},
      {"name":"r", "kind":"ordered", "type":["vector3d"]},
      {"name":"full", "kind":"flag"}
    ],
    "outputs":
    [
      {"name":"f", "type":"fibre"}
    ]
},

"calcDensity":
{
    "inputs":
    [
      {"name":"ori", "kind":"required", "type":[["orientation"],["rotation"]], "purpose":"orientations"},
      {"name":"S3G", "kind":"ordered", "type":["orientation"], "purpose":"evaluation grid"},
      {"name":"halfwidth", "kind":"namevalue", "type":["numeric","scalar",">0"], "purpose":"halfwidth of the kernel (default 10 degree)"},
      {"name":"kernel", "kind":"namevalue", "type":["SO3Kernel"], "purpose":"e.g. SO3DeLaValleePoussinKernel"},
      {"name":"weights", "kind":"namevalue", "type":["numeric"], "purpose":"weight of each orientation"},
      {"name":"resolution", "kind":"namevalue", "type":["numeric","scalar",">0"]},
      {"name":"order", "kind":"namevalue", "type":["numeric","scalar","integer",">0"], "purpose":"harmonic degree"},
      {"name":"method", "kind":"flag", "type":["char","choices={'Fourier','noFourier','Bingham','exact'}"]},
      {"name":"silent", "kind":"flag"}
    ],
    "outputs":
    [
      {"name":"odf", "type":"SO3Fun"}
    ]
},

"calcDensity":
{
    "inputs":
    [
      {"name":"v", "kind":"required", "type":["vector3d"], "purpose":"directions"},
      {"name":"S2G", "kind":"ordered", "type":["vector3d"], "purpose":"evaluation grid"},
      {"name":"halfwidth", "kind":"namevalue", "type":["numeric","scalar",">0"], "purpose":"halfwidth of the kernel (default 10 degree)"},
      {"name":"kernel", "kind":"namevalue", "type":["S2Kernel"]},
      {"name":"weights", "kind":"namevalue", "type":["numeric"]},
      {"name":"antipodal", "kind":"flag"}
    ],
    "outputs":
    [
      {"name":"sF", "type":"S2Fun"}
    ]
},

"calcCluster":
{
    "inputs":
    [
      {"name":"ori", "kind":"required", "type":[["orientation"],["vector3d"]]},
      {"name":"halfwidth", "kind":"namevalue", "type":["numeric","scalar",">0"]},
      {"name":"numCluster", "kind":"namevalue", "type":["numeric","scalar","integer",">0"]},
      {"name":"maxAngle", "kind":"namevalue", "type":["numeric","scalar",">0"]},
      {"name":"method", "kind":"namevalue", "type":["char","choices={'hierarchical','odf'}"]}
    ]
},

"calcKernel":
{
    "inputs":
    [
      {"name":"ori", "kind":"required", "type":["orientation"]},
      {"name":"method", "kind":"flag", "type":["char","choices={'RuleOfThumb','LSCV','KLCV','BCV'}"]}
    ]
},

"plot":
{
    "inputs":
    [
      {"name":"v", "kind":"required", "type":[["vector3d"],["Miller"]], "purpose":"directions"},
      {"name":"data", "kind":"ordered", "type":["numeric"], "purpose":"values or RGB colors"},
      {"name":"Marker", "kind":"namevalue", "type":["char","choices={'o','.','none','x','s','d','p','^','v','+','*'}"]},
      {"name":"MarkerSize", "kind":"namevalue", "type":["numeric","scalar",">0"]},
      {"name":"MarkerColor", "kind":"namevalue", "type":["choices=str2rgb"]},
      {"name":"MarkerFaceColor", "kind":"namevalue", "type":["choices=str2rgb"]},
      {"name":"MarkerEdgeColor", "kind":"namevalue", "type":["choices=str2rgb"]},
      {"name":"MarkerFaceAlpha", "kind":"namevalue", "type":["numeric","scalar",">=0","<=1"]},
      {"name":"MarkerEdgeAlpha", "kind":"namevalue", "type":["numeric","scalar",">=0","<=1"]},
      {"name":"label", "kind":"namevalue", "type":[["char"],["cell"],["string"]]},
      {"name":"backgroundColor", "kind":"namevalue", "type":["choices=str2rgb"]},
      {"name":"DisplayName", "kind":"namevalue", "type":["char"]},
      {"name":"contours", "kind":"namevalue", "type":["numeric"], "purpose":"number or list of contour levels"},
      {"name":"halfwidth", "kind":"namevalue", "type":["numeric","scalar",">0"], "purpose":"kernel halfwidth used by 'smooth'"},
      {"name":"resolution", "kind":"namevalue", "type":["numeric","scalar",">0"]},
      {"name":"projection", "kind":"namevalue", "type":["char","choices={'earea','edist','plain','eangle','orthographic','gnomonic','3d'}"]},
      {"name":"figSize", "kind":"namevalue", "type":[["char","choices={'tiny','small','normal','medium','large','huge'}"],["numeric","scalar"]]},
      {"name":"parent", "kind":"namevalue", "type":["matlab.graphics.axis.Axes"]},
      {"name":"drawing", "kind":"flag", "type":["char","choices={'smooth','contour','contourf','pcolor','scatter','line','surf'}"]},
      {"name":"hemisphere", "kind":"flag", "type":["char","choices={'upper','lower','complete'}"]},
      {"name":"antipodal", "kind":"flag"},
      {"name":"grid", "kind":"flag"},
      {"name":"noTitle", "kind":"flag"},
      {"name":"how2plot", "kind":"namevalue", "type":["choices={'y↑→x','y↓→x','x↑→y','x↓→y','x←↑y','x←↓y','y←↑x','y←↓x'}"], "purpose":"screen alignment for this plot only"}
    ]
},

"plot":
{
    "inputs":
    [
      {"name":"ori", "kind":"required", "type":["orientation"], "purpose":"orientations"},
      {"name":"data", "kind":"ordered", "type":["numeric"]},
      {"name":"Marker", "kind":"namevalue", "type":["char","choices={'o','.','none','x','s','d','p','^','v','+','*'}"]},
      {"name":"MarkerSize", "kind":"namevalue", "type":["numeric","scalar",">0"]},
      {"name":"MarkerColor", "kind":"namevalue", "type":["choices=str2rgb"]},
      {"name":"MarkerFaceColor", "kind":"namevalue", "type":["choices=str2rgb"]},
      {"name":"MarkerEdgeColor", "kind":"namevalue", "type":["choices=str2rgb"]},
      {"name":"MarkerFaceAlpha", "kind":"namevalue", "type":["numeric","scalar",">=0","<=1"]},
      {"name":"MarkerEdgeAlpha", "kind":"namevalue", "type":["numeric","scalar",">=0","<=1"]},
      {"name":"label", "kind":"namevalue", "type":[["char"],["cell"],["string"]]},
      {"name":"backgroundColor", "kind":"namevalue", "type":["choices=str2rgb"]},
      {"name":"DisplayName", "kind":"namevalue", "type":["char"]},
      {"name":"projection", "kind":"namevalue", "type":["char","choices={'axisAngle','Rodrigues','Euler','homochoric','quaternion','ipdf'}"]},
      {"name":"antipodal", "kind":"flag"},
      {"name":"how2plot", "kind":"namevalue", "type":["choices={'y↑→x','y↓→x','x↑→y','x↓→y','x←↑y','x←↓y','y←↑x','y←↓x'}"], "purpose":"screen alignment for this plot only"}
    ]
},

"plotPDF":
