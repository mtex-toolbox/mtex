      {"name":"how2plot", "kind":"namevalue", "type":["choices={'y↑→x','y↓→x','x↑→y','x↓→y','x←↑y','x←↓y','y←↑x','y←↓x'}"], "purpose":"screen alignment for this plot only"}
    ]
},

"plotSection":
{
    "inputs":
    [
      {"name":"ori", "kind":"required", "type":[["orientation"],["SO3Fun"],["fibre"]], "purpose":"orientations or ODF"},
      {"name":"data", "kind":"ordered", "type":["numeric"]},
      {"name":"sections", "kind":"namevalue", "type":["numeric","scalar","integer",">0"], "purpose":"number of sections"},
      {"name":"points", "kind":"namevalue", "type":[["numeric","scalar",">0"],["char","choices={'all'}"]]},
      {"name":"contours", "kind":"namevalue", "type":["numeric"]},
