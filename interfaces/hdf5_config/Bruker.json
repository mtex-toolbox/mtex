{
  "settings": {
    "name": "Bruker",
    "key_path": { "mode": "absolute", "value": "/Manufacturer"},
    "manufacturer_keys": {"data": ["Bruker", "Bruker Nano"]}
  },
  "ebsd": {
    "type": "default",
    "key": {"mode": "search_root", "value": "EBSD"},
    "position": {
      "type": "direct",
      "direct": {
        "x": { "mode": "search_root", "value": "/X Sample$" },
        "y": { "mode": "search_root", "value": "/Y Sample$" }
      }
    },
    "phase": {"mode": "search_root", "value": "/Phase", "type": "default"},
    "rotation": {
      "type": "euler",
      "euler": {
        "format": {"data": "degree"},
        "phi1": { "mode": "search_root", "value": "/phi1$" },
        "Phi":  { "mode": "search_root", "value": "/PHI$" },
        "phi2": { "mode": "search_root", "value": "/phi2$" }
      }
    },
    "map_correction": {
      "type": "by_id",
      "id" : {"mode": "search_root", "value": "/Coordinate Systems/ID"},
      "correct_data": { "data": [0, 0, 0, 0, 180]},
      "format": { "data": "degree"}
    },
    "how2plot": { "data": "x-east,y-south", "type": "default"},
    "cs": {
      "type": "default",
      "multiple": true,
      "key": { "mode": "search_root", "value": "Phases" },
      "default": {
        "space_group": { "mode": "search_root", "value": "SpaceGroup", "type": "default" },
        "space_group_id": { "mode": "search_root", "value": "/IT$", "fallback": []},
        "atoms": { "group": {"mode": "search_root", "value": "AtomPositions$"}, "type": "default"},
        "name": { "mode": "search_root", "value": "Name"},
        "lattice": { "mode": "search_root", "value": "LatticeConstants", "type": "all_together"}
      }
    },
    "header": {
      "group": {"mode": "search_root", "value": "Header"}
    },
    "unitCell": {
      "type": "fromStep",
      "step_size_x": { "mode": "search_root", "value": "XSTEP" },
      "step_size_y": { "mode": "search_root", "value": "YSTEP" }
    }
  },
  "additions": {
    "type": "auto",
    "group": { "mode": "search_root", "value": "Data"}
  }
}
