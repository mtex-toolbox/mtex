{
  "settings": {
    "name": "Bruker",
    "manufacturer_keys": {"data": ["Bruker", "Bruker Nano"]}
  },
  "ebsd": {
    "type": "default",
    "key": {"mode": "regex", "value": "EBSD"},
    "position": {
      "type": "direct",
      "direct": {
        "x": { "mode": "regex", "value": "^X Beam$" },
        "y": { "mode": "regex", "value": "^Y Beam$" }
      }
    },
    "phase": {"mode": "regex", "value": "^Phase"},
    "rotation": {
      "type": "euler",
      "euler": {
        "format": {"data": "degree"},
        "phi1": { "mode": "regex", "value": "^phi1$" },
        "Phi":  { "mode": "regex", "value": "^PHI$" },
        "phi2": { "mode": "regex", "value": "^phi2$" }
      }
    },
    "cs": {
      "type": "default",
      "multiple": true,
      "key": { "mode": "regex", "value": "Phases" },
      "default": {
        "space_group": { "mode": "regex", "value": "SpaceGroup", "type": "default" },
        "name": { "mode": "regex", "value": "Name"},
        "lattice": { "mode": "regex", "value": "LatticeConstants", "type": "all_together"}
      }
    },
    "header": {
      "group": {"mode": "regex", "value": "Header"}
    }
  },
  "additions": {
    "type": "auto",
    "key": { "mode": "regex", "value": "Data"}
  }
}
