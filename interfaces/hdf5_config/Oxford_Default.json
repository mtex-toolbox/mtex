{
  "settings": {
    "name": "Oxford_Default",
    "manufacturer_keys": {"data": ["Oxford", "Oxford Instruments"]},
    "manufacturer_info": {"data": "The Data was read from the DataProcessing field as default. If you want to read from the EBSD field use 'type', 'Oxford_EBSD'! "} 
  },
  "ebsd": {
    "type": "default",
    "key": {"mode": "regex", "value":"Data Processing"},
    "position": {
      "type": "indirect",
      "indirect": {
        "step_size_x": { "mode": "absolute", "value": "/1/EBSD/Header/X Step"},
        "step_size_y": { "mode": "absolute", "value": "/1/EBSD/Header/Y Step"},
        "grid_size_x": { "mode": "absolute", "value": "/1/EBSD/Header/X Cells"},
        "grid_size_y": { "mode": "absolute", "value": "/1/EBSD/Header/Y Cells"}
      }
    },
    "phase": {"mode": "absolute", "value": "/1/Data Processing/Data/Phase", "type": "default"},
    "rotation": {
      "type": "correctByAngle",
      "correctByAngle": {
        "angle": { "mode": "absolute", "value": "/1/EBSD/Header/Scanning Rotation Angle"},
        "rotation": {
          "type": "euler",
          "euler": {
            "format": { "data": "radian"},
            "phi": { "mode": "regex", "value": "Euler"}
          }
        }
      }
    }, 
    "cs": {
      "type": "default",
      "key": { "mode": "regex", "value": "Phases" },
      "multiple": true,
      "default": {
        "reference_frame": { "data": "X||a*, Z||c"},
        "space_group": { "mode": "regex", "value": "Space Group", "type": "default" },
        "name": { "mode": "regex", "value": "Phase Name"},
        "lattice": {
          "angle": { "mode": "regex", "value": "Lattice Angles"},
          "dim": { "mode": "regex", "value": "Lattice Dimensions"}
        }
      }
    },
    "header": {
      "group": {"mode": "absolute", "value": "/1/Data Processing/Header"}
    }
  },
  "additions": {
    "type": "auto",
    "key": { "mode": "absolute", "value": "/1/Data Processing/Data"}
  },
  "electron_image": {
    "key" : { "mode": "regex", "value": "Electron Image" },
    "type": "default",
    "optional": true,
    "image_data": {
      "type": "default",
      "default": {
        "FSE": { "group": {"mode": "regex", "value": "FSE"}},
        "SE": { "group": {"mode": "regex", "value": "^.*/SE"}},
        "x_size": {"mode": "regex", "value": "X Cells"},
        "y_size": {"mode": "regex", "value": "Y Cells"}
      }
    },
    "header": {
      "group": {"mode": "regex", "value": "Header"}
    }
  }
}
