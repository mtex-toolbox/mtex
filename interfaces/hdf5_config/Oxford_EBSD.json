{
  "settings": {
    "name": "Oxford_EBSD",
    "key_path": { "mode": "absolute", "value": "/Manufacturer"},
    "manufacturer_keys": {"data": "Oxford_EBSD"},
    "manufacturer_info": {"data": "Reading Data from EBSD field!"} 
  },
  "ebsd": {
    "type": "default",
    "key": {"mode": "search_root", "value": "EBSD"},
    "position": {
      "type": "direct",
      "direct": {
        "x": { "mode": "search_root", "value": "/X$" },
        "y": { "mode": "search_root", "value": "/Y$" }
      }
    },
    "phase": {"mode": "search_root", "value": "Phase", "type": "default"},
    "rotation": {
      "type": "euler",
      "euler": {
        "format": { "data": "radian"},
        "phi": { "mode": "search_root", "value": "Euler"}
      }
    },
    "cs": {
      "type": "default",
      "key": { "mode": "search_root", "value": "Phases" },
      "multiple": true,
      "optional": true,
      "default": {
        "reference_frame": { "data": "X||a*, Z||c"},
        "space_group": { "mode": "search_root", "value": "Space Group", "type": "default" },
        "name": { "mode": "search_root", "value": "Phase Name"},
        "lattice": {
          "angle": { "mode": "search_root", "value": "Lattice Angles"},
          "dim": { "mode": "search_root", "value": "Lattice Dimensions"}
        }
      }
    },
    "header": {
      "group": {"mode": "search_root", "value": "Header"}
    }
  },
  "additions": {
    "type": "auto",
    "group": { "mode": "search_root", "value": "/1/EBSD/Data"}
  },
  "electron_image": {
    "optional": true,
    "key" : { "mode": "search_root", "value": "Electron Image" },
    "type": "default",
    "image_data": {
      "type": "default",
      "default": {
        "FSE": { "group": {"mode": "search_root", "value": "FSE"}},
        "SE": { "group": {"mode": "search_root", "value": "^.*/SE"}},
        "x_size": {"mode": "search_root", "value": "X Cells"},
        "y_size": {"mode": "search_root", "value": "Y Cells"}
      }
    },
    "header": {
      "group": {"mode": "search_root", "value": "Header"}
    }
  }
}
